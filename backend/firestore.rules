// ============================================================
//  firestore.rules
//  انسخ هذا الملف إلى Firebase Console → Firestore → Rules
// ============================================================
//
//  المبدأ: كل الوصول من الـ Backend فقط عبر Firebase Admin SDK
//  لا أحد يستطيع القراءة أو الكتابة مباشرة من المتصفح
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── BLOCK EVERYTHING by default ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
