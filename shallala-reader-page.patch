+
+        {/* لوحة الأرقام */}
+        {curMeter.editable && !confirming && (
+          <div style={{ margin: '12px 16px 0', display: 'grid', gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: 8, direction: 'ltr' }}>
